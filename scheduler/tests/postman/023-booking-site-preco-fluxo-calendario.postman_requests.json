              "pm.test(\"status ERROR\", function () { pm.expect(pm.response.json().status).to.eql(\"ERROR\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Cotação com serviço que não é da clínica",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{BOOKING_API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/public/clinics/{{clinicId}}/quote",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "public",
            "clinics",
            "{{clinicId}}",
            "quote"
          ]
        },
        "description": "400 - serviço de outra clínica nunca entra no carrinho.",
        "body": {
          "mode": "raw",
          "raw": "{\"serviceIds\": [\"00000000-0000-4000-8000-000000000000\"]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
