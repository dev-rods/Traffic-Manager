    {
      "name": "Disponibilidade pelo carrinho (mês vigente)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{BOOKING_API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/public/clinics/{{clinicId}}/availability?dates={{hoje}},{{amanha}},{{mesQueVem}}&serviceIds={{serviceId}}&serviceAreaPairs={{serviceId}}:{{areaId}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "public",
            "clinics",
            "{{clinicId}}",
            "availability"
          ],
          "query": [
            {
              "key": "dates",
              "value": "{{hoje}},{{amanha}},{{mesQueVem}}"
            },
            {
              "key": "serviceIds",
              "value": "{{serviceId}}"
            },
            {
              "key": "serviceAreaPairs",
              "value": "{{serviceId}}:{{areaId}}"
            }
          ]
        },
        "description": "Duração calculada no backend a partir do carrinho, a mesma da criação. Datas fora do mês voltam CLOSED."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "var r = pm.response.json();",
              "pm.test(\"Tem window\", function () { pm.expect(r.window).to.have.keys([\"start\",\"end\",\"nextOpensOn\"]); });",
              "pm.test(\"Mês seguinte fechado\", function () {",
              "    pm.expect(r.days[pm.collectionVariables.get(\"mesQueVem\")].status).to.eql(\"CLOSED\");",
              "});",
              "var livre = Object.keys(r.days).find(function (d) { return r.days[d].status === \"AVAILABLE\"; });",
              "if (livre) { pm.collectionVariables.set(\"dataLivre\", livre); pm.collectionVariables.set(\"horaLivre\", r.days[livre].slots[0]); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Disponibilidade legada (totalDuration)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{BOOKING_API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/public/clinics/{{clinicId}}/availability?dates={{hoje}},{{amanha}}&totalDuration=30",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "public",
            "clinics",
            "{{clinicId}}",
            "availability"
          ],
          "query": [
            {
              "key": "dates",
              "value": "{{hoje}},{{amanha}}"
            },
            {
              "key": "totalDuration",
              "value": "30"
            }
          ]
        },
        "description": "Front antigo em cache durante o deploy. Continua aceito e logado como legado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Criar agendamento (sem profissional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{BOOKING_API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/public/clinics/{{clinicId}}/appointments",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "public",
            "clinics",
            "{{clinicId}}",
            "appointments"
          ]
        },
        "description": "Profissional atribuído pelo backend. Desconto gravado = o da cotação com o mesmo telefone. Confirmação + orientações por WhatsApp.",
        "body": {
          "mode": "raw",
          "raw": "{\"phone\": \"{{telefoneNovo}}\", \"fullName\": \"Teste 023\", \"serviceIds\": [\"{{serviceId}}\"], \"date\": \"{{dataLivre}}\", \"time\": \"{{horaLivre}}\", \"serviceAreaPairs\": [{\"serviceId\": \"{{serviceId}}\", \"areaId\": \"{{areaId}}\"}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "var a = pm.response.json().appointment;",
              "pm.test(\"Profissional atribuído\", function () { pm.expect(a.professional_id).to.be.a(\"string\"); });",
              "pm.test(\"Valor gravado = valor cotado\", function () {",
              "    pm.expect(a.final_price_cents).to.eql(pm.collectionVariables.get(\"finalCotado\"));",
              "});",
              "pm.collectionVariables.set(\"appointmentId\", a.id);"
            ]
          }
        }
      ]
    },
