{
  "info": {
    "name": "Clinic Scheduler - Prontuario (historico por sessao)",
    "description": "PRD/Spec 012. Os valores esperados vem do anexo docs/work/prd/012-anexo-mapa-areas-protocolo.md - confira contra ele, nao contra a memoria.\n\nO caso que mais importa e o 3: a area composta 'Virilha Completa + anus' tem de abrir em DUAS aplicacoes, com metodos diferentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://YOUR_API_GATEWAY_URL.execute-api.us-east-1.amazonaws.com",
      "type": "string"
    },
    {
      "key": "ENVIRONMENT",
      "value": "dev",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "YOUR_API_KEY_HERE",
      "type": "string"
    },
    {
      "key": "clinicId",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Protocolo do laser (referencia)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/laser-protocol",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "laser-protocol"
          ]
        },
        "description": "A tabela de referencia inteira, numa chamada so."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "",
              "// 74 linhas dos PDFs + 6 dadas pela clinica.",
              "pm.test(\"80 parametros\", function () {",
              "    pm.expect(pm.response.json().parameters).to.have.lengthOf(80);",
              "});",
              "",
              "pm.test(\"Os tres metodos, com seus campos\", function () {",
              "    var m = pm.response.json().methods;",
              "    var porChave = {};",
              "    m.forEach(function (x) { porChave[x.key] = x.fields; });",
              "    pm.expect(porChave.SHR).to.eql([\"fluence_j\", \"energy_kj\"]);",
              "    pm.expect(porChave.SHR_STACKING).to.eql([\"fluence_j\", \"stacks\", \"passes\"]);",
              "});",
              "",
              "// 36 areas, 4 delas compostas abrindo em duas.",
              "pm.test(\"40 ligacoes de area\", function () {",
              "    pm.expect(pm.response.json().area_map).to.have.lengthOf(40);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Marcar tipo de pele (BRANCA)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/patients/{{patientId}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "Marcado SO pela profissional. O bot nunca escreve aqui.",
        "body": {
          "mode": "raw",
          "raw": "{\"skin_type\": \"BRANCA\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Gravou\", function () {",
              "    pm.expect(pm.response.json().patient.skin_type).to.eql(\"BRANCA\");",
              "});"
            ]
          }
        }
      ]
    },
