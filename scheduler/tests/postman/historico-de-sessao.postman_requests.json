    {
      "name": "Criar registro a partir do agendamento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/patients/{{patientId}}/session-records",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "patients",
            "{{patientId}}",
            "session-records"
          ]
        },
        "description": "Escolhida a sessao, as areas vem prontas com o parametro do protocolo.",
        "body": {
          "mode": "raw",
          "raw": "{\"appointmentId\": \"{{appointmentId}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "",
              "// O CASO CENTRAL. Use um agendamento com 'Virilha Completa +",
              "// anus': no catalogo e uma area, no protocolo sao duas, com",
              "// metodos diferentes - e e o que ela de fato aplica.",
              "pm.test(\"A area composta abriu em duas aplicacoes\", function () {",
              "    var aps = pm.response.json().record.applications;",
              "    var virilha = aps.filter(function (a) {",
              "        return a.protocol_area_key === \"virilha_completa\";",
              "    })[0];",
              "    var perianal = aps.filter(function (a) {",
              "        return a.protocol_area_key === \"regiao_perianal\";",
              "    })[0];",
              "    pm.expect(virilha, 'virilha_completa').to.not.be.undefined;",
              "    pm.expect(perianal, 'regiao_perianal').to.not.be.undefined;",
              "    pm.expect(virilha.method).to.eql(\"SHR\");",
              "    pm.expect(perianal.method).to.eql(\"SHR_STACKING\");",
              "});",
              "",
              "// Pele branca: virilha completa = 7 J / 6 kJ no SHR.",
              "pm.test(\"O parametro veio do protocolo da pele certa\", function () {",
              "    var aps = pm.response.json().record.applications;",
              "    var v = aps.filter(function (a) {",
              "        return a.protocol_area_key === \"virilha_completa\";",
              "    })[0];",
              "    pm.expect(Number(v.fluence_j)).to.eql(7);",
              "    pm.expect(Number(v.energy_kj)).to.eql(6);",
              "});",
              "",
              "pm.collectionVariables.set(\"recordId\", pm.response.json().record.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Editar: o anterior nao se perde",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/session-records/{{recordId}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "session-records",
            "{{recordId}}"
          ]
        },
        "description": "Decisao do Andre: edita, e o estado anterior fica guardado.",
        "body": {
          "mode": "raw",
          "raw": "{\"notes\": \"Pele reagiu bem.\", \"applications\": [{\"areaName\": \"Axilas\", \"method\": \"SHR\", \"fluenceJ\": 8, \"energyKj\": 8, \"protocolAreaKey\": \"axilas\", \"areaId\": null, \"stacks\": null, \"passes\": null, \"displayOrder\": 0}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Marcado como editado\", function () {",
              "    pm.expect(pm.response.json().record.edit_count).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Campo que o metodo nao usa e descartado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/session-records/{{recordId}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "session-records",
            "{{recordId}}"
          ]
        },
        "description": "Tela desatualizada mandando campo a mais nao polui o historico.",
        "body": {
          "mode": "raw",
          "raw": "{\"applications\": [{\"areaName\": \"Axilas\", \"method\": \"SHR\", \"fluenceJ\": 7, \"energyKj\": 8, \"stacks\": 3, \"passes\": 2, \"protocolAreaKey\": \"axilas\", \"areaId\": null, \"displayOrder\": 0}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "",
              "// O SHR nao usa stacks. Gravar sujaria a consulta que",
              "// justifica a tabela de aplicacoes existir.",
              "pm.test(\"stacks e passes viraram null\", function () {",
              "    var a = pm.response.json().record.applications[0];",
              "    pm.expect(a.stacks).to.be.null;",
              "    pm.expect(a.passes).to.be.null;",
              "});"
            ]
          }
        }
      ]
    },
