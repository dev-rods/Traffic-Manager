            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "session-records",
            "{{recordId}}"
          ]
        },
        "description": "Soft delete. A trilha sobrevive ao registro."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "",
              "// Rode a trilha depois deste request: o DELETE tem de estar la,",
              "// com o estado completo de antes. Prontuario apagado sem rastro",
              "// nao serve como registro de nada."
            ]
          }
        }
      ]
