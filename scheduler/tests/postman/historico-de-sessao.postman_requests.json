    {
      "name": "Trilha de alteracoes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/session-records/{{recordId}}/history",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "session-records",
            "{{recordId}}",
            "history"
          ]
        },
        "description": "O que o selo 'editado' abre na tela."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Tem CREATE e UPDATE\", function () {",
              "    var acoes = pm.response.json().history.map(function (h) { return h.action; });",
              "    pm.expect(acoes).to.include(\"CREATE\");",
              "    pm.expect(acoes).to.include(\"UPDATE\");",
              "});",
              "",
              "// Snapshot completo e nao diff: o estado do CREATE tem de",
              "// reconstituir sozinho o que havia antes da edicao.",
              "pm.test(\"O snapshot do CREATE tem as aplicacoes de antes\", function () {",
              "    var criacao = pm.response.json().history.filter(function (h) {",
              "        return h.action === \"CREATE\";",
              "    })[0];",
              "    pm.expect(criacao.snapshot.applications.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar registros do paciente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/clinics/{{clinicId}}/patients/{{patientId}}/session-records",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "clinics",
            "{{clinicId}}",
            "patients",
            "{{patientId}}",
            "session-records"
          ]
        },
        "description": "Registros em ordem decrescente, com as aplicacoes embutidas."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "",
              "// O paciente vem junto: a tela nao tem um GET de paciente.",
              "pm.test(\"Traz o paciente\", function () {",
              "    pm.expect(pm.response.json().patient).to.have.property('skin_type');",
              "});",
              "",
              "// So os CONFIRMED que ainda nao viraram registro. E o que",
              "// evita a sessao duplicada.",
              "pm.test(\"Agendamentos sem registro nao incluem o ja registrado\", function () {",
              "    var pendentes = pm.response.json().appointments_without_record;",
              "    var ids = pendentes.map(function (a) { return a.id; });",
              "    pm.expect(ids).to.not.include(pm.collectionVariables.get(\"appointmentId\"));",
              "});"
            ]
          }
        }
      ]
    },
