{
  "info": {
    "name": "Clinic Scheduler - Check-in 026 (autoatendimento com pagamento)",
    "description": "PRD/Spec 026. Só dev. Rode na ordem. Preencha clinicId, phone (com agendamento futuro), token (de /verify/confirm com o mesmo phone) e cpf (válido). Dev usa o Asaas sandbox; sem ASAAS_API_KEY, o provedor simulado. As requests de Caixa (fase 2) usam a auth do painel (API_KEY = chave do admin; a baixa em dinheiro também aceita a sessão da recepção com agenda.escrever) e precisam de um segundo agendamento futuro do mesmo número para a cobrança em dinheiro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://YOUR_API_GATEWAY_URL.execute-api.us-east-1.amazonaws.com",
      "type": "string"
    },
    {
      "key": "ENVIRONMENT",
      "value": "dev",
      "type": "string"
    },
    {
      "key": "BOOKING_API_KEY",
      "value": "YOUR_BOOKING_API_KEY_HERE",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "YOUR_API_KEY_HERE",
      "type": "string"
    },
    {
      "key": "clinicId",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "cpf",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pixPaymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cashAppointmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cashPaymentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Agendamentos do número",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{BOOKING_API_KEY}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/{{ENVIRONMENT}}/public/clinics/{{clinicId}}/checkin/appointments?phone={{phone}}&token={{token}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "{{ENVIRONMENT}}",
            "public",
            "clinics",
            "{{clinicId}}",
            "checkin",
            "appointments"
          ],
          "query": [
            {
              "key": "phone",
              "value": "{{phone}}"
            },
            {
              "key": "token",
              "value": "{{token}}"
            }
          ]
        },
        "description": "Próximos agendamentos confirmados do número (até 5). Exige o token do código de WhatsApp."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "var l = pm.response.json().appointments;",
              "pm.test(\"Tem agendamento\", function () { pm.expect(l.length).to.be.above(0); });",
              "pm.collectionVariables.set(\"appointmentId\", l[0].id);",
              "pm.test(\"Campos da tela\", function () { pm.expect(l[0]).to.include.keys([\"fullName\",\"date\",\"startTime\",\"areas\",\"finalPriceCents\",\"checkedInAt\",\"payment\"]); });",
              "if (l.length > 1) { pm.collectionVariables.set(\"cashAppointmentId\", l[1].id); }"
            ]
          }
        }
      ]
    },
