# Só para `npm run dev`: alvo do proxy /api do Vite. Em produção o rewrite da
# Vercel (vercel.json) decide o stage pelo host. Padrão: API Gateway de dev.
VITE_API_PROXY_TARGET=https://tuvr5sfhz3.execute-api.us-east-1.amazonaws.com/dev

# Chave restrita aos endpoints public/* (BOOKING_INTAKE_API_KEY provisionada no SSM do backend).
# Não é segredo real — é só um filtro básico contra bots, por isso pode ir no bundle público.
VITE_BOOKING_API_KEY=
