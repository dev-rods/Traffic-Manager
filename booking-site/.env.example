# URL base da API do scheduler (API Gateway do stage correspondente)
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# Chave restrita aos endpoints public/* (BOOKING_INTAKE_API_KEY provisionada no SSM do backend).
# Não é segredo real — é só um filtro básico contra bots, por isso pode ir no bundle público.
VITE_BOOKING_API_KEY=
